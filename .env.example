# ===== BTG Robotics Foundation - Environment Variables =====

# Security
SECRET_KEY=generate-a-random-secret-key-here

# Set to "production" to enable secure cookies and require the settings below.
# Leave unset (or "development") for local development.
FLASK_ENV=production

# Database
# Default (SQLite, fine for a small self-hosted deployment):
# DATABASE_URL=sqlite:///data/btg.db
#
# For PostgreSQL instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Seed credentials (only used if DB has no super admin yet on first run)
BTG_ADMIN_EMAIL=admin@bridgethegaprobotics.org
BTG_ADMIN_PASSWORD=your-secure-admin-password
BTG_PRESIDENT_PASSWORD=your-secure-president-password

# Named super admin, created on first run if that username is not taken.
# Leave blank to skip. An existing account with this username is never
# overwritten, so changing the password here later has no effect.
BTG_SUPER_ADMIN_USERNAME=
BTG_SUPER_ADMIN_PASSWORD=
BTG_SUPER_ADMIN_NAME=
BTG_SUPER_ADMIN_EMAIL=
